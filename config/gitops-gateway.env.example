SENTINELOPS_ENVIRONMENT=development
SENTINELOPS_GITOPS_BEARER_TOKEN_FILE=.local/secrets/gitops-token
SENTINELOPS_GITOPS_GITHUB_TOKEN_FILE=.local/secrets/gitops-github-token
SENTINELOPS_GITOPS_GITHUB_API_URL=https://api.github.com
SENTINELOPS_GITOPS_GITHUB_REPOSITORY=replace-owner/replace-config-repo
SENTINELOPS_GITOPS_GITHUB_BASE_BRANCH=main
SENTINELOPS_GITOPS_GITHUB_PROPOSAL_PATH=sentinelops/proposals
SENTINELOPS_GITOPS_GITHUB_TIMEOUT_SECONDS=15
SENTINELOPS_GITOPS_GITHUB_DEADLINE_SECONDS=45
