SENTINELOPS_ENVIRONMENT=development
SENTINELOPS_DATABASE_URL_FILE=.local/secrets/database-url
SENTINELOPS_AUDIT_HMAC_KEY_FILE=.local/secrets/audit-hmac-key
SENTINELOPS_AUDIT_KEY_ID=local-audit-v1
SENTINELOPS_GITOPS_GATEWAY_URL=http://127.0.0.1:8020/v1/proposals
SENTINELOPS_GITOPS_BEARER_TOKEN_FILE=.local/secrets/gitops-token
SENTINELOPS_GITOPS_TIMEOUT_SECONDS=15
SENTINELOPS_GITOPS_CLAIM_TTL_SECONDS=60
